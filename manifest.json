{
  "manifest_version": 3,
  "name": "Sida 100",
  "short_name": "Sida 100",
  "version": "1.0.0",
  "description": "Omvandlar vilken webbsida som helst till klassisk TextTV/Teletext-estetik",
  "icons": {
    "16":  "sida100_icons/sida100_icon16.png",
    "48":  "sida100_icons/sida100_icon48.png",
    "128": "sida100_icons/sida100_icon128.png"
  },
  "action": {
    "default_popup": "sida100_popup/sida100_popup.html",
    "default_title": "Sida 100",
    "default_icon": {
      "16": "sida100_icons/sida100_icon16.png",
      "48": "sida100_icons/sida100_icon48.png"
    }
  },
  "background": {
    "service_worker": "sida100_background.js"
  },
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["sida100_content.js"],
      "css": ["sida100_content.css"],
      "run_at": "document_idle",
      "all_frames": false
    }
  ],
  "permissions": [
    "activeTab",
    "scripting",
    "storage",
    "tabs"
  ],
  "host_permissions": [
    "<all_urls>"
  ]
}
