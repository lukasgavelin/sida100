{
  "manifest_version": 3,
  "name": "__MSG_extName__",
  "short_name": "__MSG_extShortName__",
  "version": "1.0.0",
  "description": "__MSG_extDescription__",
  "author": "Lukas Gavelin",
  "homepage_url": "https://github.com/lukasgavelin/sida100",
  "default_locale": "sv",
  "icons": {
    "16":  "sida100_icons/sida100_icon16.png",
    "48":  "sida100_icons/sida100_icon48.png",
    "128": "sida100_icons/sida100_icon128.png"
  },
  "action": {
    "default_popup": "sida100_popup/sida100_popup.html",
    "default_title": "Sida 100",
    "default_icon": {
      "16": "sida100_icons/sida100_icon16.png",
      "48": "sida100_icons/sida100_icon48.png"
    }
  },
  "commands": {
    "toggle-sida100": {
      "suggested_key": {
        "default": "Alt+T",
        "mac": "Alt+T"
      },
      "description": "__MSG_commandToggleDesc__"
    }
  },
  "background": {
    "service_worker": "sida100_background.js"
  },
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["sida100_content.js"],
      "css": ["sida100_content.css"],
      "run_at": "document_idle",
      "all_frames": false
    }
  ],
  "permissions": [
    "activeTab",
    "scripting",
    "storage",
    "tabs"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'"
  },
  "web_accessible_resources": [
    {
      "resources": ["fonts/VT323-Regular.ttf"],
      "matches": ["http://*/*", "https://*/*"]
    }
  ]
}
